# Desktop defaults for every account.

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/koanga/Koanga_Clay-on-Blush.xml'
picture-uri-dark='file:///usr/share/backgrounds/koanga/Koanga_Sage-on-Olive.xml'
picture-options='zoom'

[org/gnome/desktop/input-sources]
sources=[('xkb', 'nz+mao')]

[org/gnome/desktop/interface]
icon-theme='Koanga'

[org/gnome/desktop/screensaver]
lock-enabled=false

[org/gnome/desktop/lockdown]
disable-lock-screen=true

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com']
favorite-apps=['io.github.ungoogled_software.ungoogled_chromium.desktop', 'org.onlyoffice.desktopeditors.desktop', 'org.gnome.Nautilus.desktop']
