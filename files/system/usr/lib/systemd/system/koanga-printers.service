[Unit]
Description=Add Kōanga's Fuji ApeosPort printer
ConditionPathExists=!/etc/cups/ppd/FUJI_XEROX_ApeosPort_VII_C3321_5c_b6_47.ppd
Requires=cups.socket
After=cups.socket

[Service]
Type=oneshot
ExecStart=/usr/libexec/koanga-workstation/add-fuji-printer

[Install]
WantedBy=multi-user.target
