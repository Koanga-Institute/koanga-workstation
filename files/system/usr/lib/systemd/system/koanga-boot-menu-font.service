[Unit]
Description=Give the boot menu a font with macrons
RequiresMountsFor=/boot

[Service]
Type=oneshot
ExecStart=/usr/libexec/koanga-workstation/set-boot-menu-font

[Install]
WantedBy=multi-user.target
