[Unit]
Description=Create the Kōanga account
ConditionPathExists=!/home/koanga
RequiresMountsFor=/var/home
After=systemd-sysusers.service
Before=systemd-user-sessions.service display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/koanga-workstation/create-koanga-account

[Install]
WantedBy=multi-user.target
